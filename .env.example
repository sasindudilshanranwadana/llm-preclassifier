# Runtime configuration. Do not commit real credentials.
LLM_PRECLASSIFIER_ENV=development
# In production, configure one or more comma-separated values and use a secret manager.
CLIENT_API_KEYS=
MAX_REQUEST_BYTES=65536
MAX_MESSAGES=32
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1024
# Logging is disabled by default. It records decision metadata only, never prompts.
LOG_DECISIONS=false
DECISION_LOG_PATH=

# Optional offline semantic layer (requires the `semantic` extra; empty disables it).
SEMANTIC_MODEL=
SEMANTIC_CACHE_DIR=

# Custom routing policy YAML (empty uses the bundled default; validated at startup).
POLICY_PATH=

# Optional feedback endpoint: POST /v1/feedback records corrections (metadata only).
ENABLE_FEEDBACK=false
FEEDBACK_LOG_PATH=

# Custom model catalog YAML (empty uses the bundled default; validated at startup).
MODEL_CATALOG_PATH=

# Optional OpenAI-compatible proxy: POST /v1/chat/completions classifies, then
# forwards the request unmodified to PROXY_UPSTREAM_BASE_URL.
ENABLE_PROXY=false
PROXY_UPSTREAM_BASE_URL=
PROXY_UPSTREAM_API_KEY=
PROXY_TIMEOUT_SECONDS=60

# Optional Prometheus metrics at GET /metrics (unauthenticated, like /healthz).
ENABLE_METRICS=false

# Optional Redis-backed decision cache, shared across instances (requires the `redis` extra).
REDIS_URL=

# Optional per-key rate limiting on classify/feedback/proxy endpoints (0 disables).
RATE_LIMIT_PER_MINUTE=0
